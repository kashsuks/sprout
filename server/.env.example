# Server
NODE_ENV=development
PORT=4000
CORS_ALLOWED_ORIGINS=

# MongoDB Atlas
MONGODB_URI=

# Firebase Admin (service account, scoped to Auth Admin only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# DigitalOcean Spaces (S3-compatible) — used from Milestone 4 onward
DO_SPACES_ENDPOINT=
DO_SPACES_REGION=
DO_SPACES_BUCKET=
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_CDN_BASE_URL=

# Contacts-matching pepper (HMAC secret shared with the client hashing scheme) — used from Milestone 5 onward
CONTACT_HASH_SALT=
